Có thể bỏ AionUi UI nhưng giữ pattern:

```text
POST /api/v1/office/jobs
        |
        v
OfficeJobOrchestrator
        |
        +--> LLM
        |
        +--> Office skill prompt
        |
        +--> sandboxed command runner
                  |
                  v
              officecli
```

Rust pseudo-code:

```rust
pub struct OfficeJobOrchestrator {
    llm: Arc<dyn Llm>,
    runner: Arc<dyn CommandRunner>,
}

impl OfficeJobOrchestrator {
    pub async fn execute(
        &self,
        request: OfficeRequest,
    ) -> Result<OfficeResult> {
        let plan =
            self.llm
                .plan_office_job(
                    &request
                )
                .await?;

        for operation in plan.operations {
            let output =
                self.runner
                    .run(
                        "officecli",
                        &operation.args,
                        &request.workspace,
                    )
                    .await?;

            if !output.success {
                let repair =
                    self.llm
                        .repair_operation(
                            &operation,
                            &output.stderr,
                        )
                        .await?;

                self.runner
                    .run(
                        "officecli",
                        &repair.args,
                        &request.workspace,
                    )
                    .await?;
            }
        }

        Ok(
            OfficeResult {
                file:
                    plan.output_file,
            }
        )
    }
}
```

