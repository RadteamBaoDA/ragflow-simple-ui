# 21. Minimal enterprise implementation

Nếu chỉ cần MVP:

```python
import json
import subprocess
from pathlib import Path

ALLOWED = {
    "create",
    "open",
    "close",
    "get",
    "query",
    "view",
    "validate",
    "add",
    "set",
    "remove",
}

class OfficeCliExecutor:
    def __init__(self, workspace: str):
        self.workspace = Path(
            workspace
        ).resolve()

    def execute(
        self,
        command: str,
        args: list[str],
    ) -> str:
        if command not in ALLOWED:
            raise ValueError(
                "command not allowed"
            )

        result = subprocess.run(
            [
                "officecli",
                command,
                *args,
            ],
            cwd=self.workspace,
            capture_output=True,
            text=True,
            shell=False,
            timeout=120,
        )

        if result.returncode != 0:
            raise RuntimeError(
                result.stderr
            )

        return result.stdout


class OfficeAgent:
    def __init__(
        self,
        llm,
        executor: OfficeCliExecutor,
    ):
        self.llm = llm
        self.executor = executor

    def run(
        self,
        user_request: str,
    ):
        plan = self.llm.create_plan(
            user_request
        )

        history = []

        for operation in plan:
            result = (
                self.executor.execute(
                    operation["command"],
                    operation["args"],
                )
            )

            history.append({
                "operation": operation,
                "result": result,
            })

        return history
```

