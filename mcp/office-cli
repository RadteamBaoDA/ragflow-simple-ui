Core:

```rust
async fn forward_inner(
    &self,
    port: u16,
    path: &str,
    proxy_base: &str,
    request_headers: &[
        (String, String)
    ],
) -> Result<
    ProxyResponse,
    ProxyError
> {
    let target_url =
        build_target_url(
            port,
            path
        );

    let resp =
        self.client
            .get(&target_url)
            .headers(req_headers)
            .send()
            .await
            .map_err(/* ... */)?;

    let status =
        resp.status().as_u16();

    let resp_headers =
        resp.headers().clone();

    let body =
        resp.bytes()
            .await
            .map_err(/* ... */)?;

    // rewrite headers / HTML navigation

    Ok(
        ProxyResponse {
            status,
            headers: out_headers,
            body: body_bytes,
        }
    )
}
